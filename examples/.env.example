# Export these variables yourself; demos do not automatically load this file.
# Real credentials stay on your server. Never commit a filled-in env file.
BOLT_API_BASE=https://api.boltutil.com
BOLT_API_KEY=bt_live_REPLACE_WITH_YOUR_KEY
BOLT_WEBHOOK_SECRET=REPLACE_WITH_YOUR_ACTIVE_WEBHOOK_SECRET
BOLT_NOTIFY_URL=https://merchant.example.com/webhooks/boltutil
BOLT_RETURN_URL=https://merchant.example.com/orders/return
# Optional stable business order ID. Omit to generate a random demo ID.
# BOLT_EXTERNAL_ORDER_ID=SHOP_ORDER_20261016_001
BOLT_LISTEN_HOST=127.0.0.1
PORT=3000
# Default 0: no database handler, return 503. 1: LOCAL TEST ONLY, return 204.
BOLT_DEMO_ACK=0
